{
  "name": "@tenderly/cre-preflight",
  "version": "0.1.1",
  "description": "Preflight a transaction on a Tenderly Virtual Environment from inside a Chainlink CRE workflow, and get a consensus-verified verdict back.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tenderly/tenderly-cre-preflight.git"
  },
  "homepage": "https://github.com/Tenderly/tenderly-cre-preflight#readme",
  "bugs": {
    "url": "https://github.com/Tenderly/tenderly-cre-preflight/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "bun": ">=1.4.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun test",
    "compile:example": "bash scripts/compile-example.sh",
    "changeset": "changeset",
    "release": "changeset publish",
    "prepublishOnly": "bun run typecheck && bun test && bun run build",
    "prepare": "bun run build"
  },
  "keywords": [
    "tenderly",
    "chainlink",
    "cre",
    "preflight",
    "virtual-environment",
    "simulation",
    "evm"
  ],
  "peerDependencies": {
    "@chainlink/cre-sdk": "^1.22.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@chainlink/cre-sdk": "1.22.0",
    "@changesets/cli": "3.0.3",
    "@types/bun": "1.2.21",
    "typescript": "5.9.3",
    "zod": "3.25.76"
  }
}
